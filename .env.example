# ==============================================================================
# DHARITRI SENTU — WINDOWS ENVIRONMENT TEMPLATE
# Copy to .env and configure local values.
# NEVER commit production credentials or actual secret keys to the repository.
# ==============================================================================

# Application & API Mode
VITE_API_MODE=true
NODE_ENV=development
HOST=127.0.0.1
PORT=8787
APP_PUBLIC_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_DAYS=7
ENABLE_DEMO_ACCOUNTS=true

# Storage & SQLite
DATA_DIR=./server/storage
# Optional explicit 32-byte encryption key (base64 or hex). In development, an encryption key is auto-generated in storage/.document-encryption-key
DOCUMENT_ENCRYPTION_KEY=

# MapTiler Basemap (Satellite & Cadastral Vector Tiles)
VITE_MAPTILER_API_KEY=your_maptiler_key_here
VITE_SATELLITE_API_KEY=your_maptiler_key_here

# ClamAV Antivirus Scanner (Windows Configuration)
# Default Windows installation path: C:\Program Files\ClamAV\clamscan.exe
CLAMSCAN_BIN=C:\Program Files\ClamAV\clamscan.exe
CLAMAV_DB_DIR=C:\Program Files\ClamAV\database

# Tesseract OCR Engine (Windows Configuration)
# Default Windows installation path: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_BIN=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSDATA_PREFIX=C:\Program Files\Tesseract-OCR\tessdata

# Setu by Pine Labs — DigiLocker Sandbox
SETU_DIGILOCKER_BASE_URL=https://dg-sandbox.setu.co
SETU_DIGILOCKER_CLIENT_ID=your_setu_client_id_here
SETU_DIGILOCKER_CLIENT_SECRET=your_setu_client_secret_here
SETU_DIGILOCKER_PRODUCT_INSTANCE_ID=your_product_instance_id_here
SETU_DIGILOCKER_REDIRECT_URI=http://localhost:5173/api/integrations/digilocker/callback


# Legacy Google Gemini AI Model (Optional fallback)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Assam Land Records (Authorised Departmental API Gateway)
# Leave blank until departmental MoU and gateway credentials are confirmed
ASSAM_LAND_RECORDS_LOOKUP_URL=
ASSAM_LAND_RECORDS_API_KEY=

# SMTP Email Configuration (Password Resets & Notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
