{
  "name": "dharitri-sentu",
  "private": true,
  "version": "1.0.0",
  "description": "Dharitri Sentu — Assam land marketplace and LandLocker full-stack app",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "node scripts/test-ui.mjs",
    "test:e2e": "playwright test",
    "lint": "tsc --noEmit",
    "server": "node --watch --env-file-if-exists=.env server/index.mjs",
    "dev:full": "node scripts/run-dev.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "create:reviewer": "node --env-file-if-exists=.env server/create-reviewer.mjs",
    "test:api": "node scripts/api-smoke-test.mjs && node scripts/api-rescan-test.mjs",
    "doctor": "node --env-file-if-exists=.env scripts/doctor.mjs"
  },
  "dependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.3.1",
    "autoprefixer": "10.4.19",
    "clsx": "2.1.1",
    "framer-motion": "11.2.10",
    "leaflet": "1.9.4",
    "lucide-react": "0.395.0",
    "maplibre-gl": "^6.16.0",
    "nodemailer": "^10.3.1",
    "postcss": "8.4.38",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-leaflet": "4.2.1",
    "react-router-dom": "6.23.1",
    "recharts": "2.12.7",
    "tailwind-merge": "2.3.0",
    "tailwindcss": "3.4.4",
    "typescript": "5.4.5",
    "vite": "5.3.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "1.44.1",
    "@testing-library/jest-dom": "6.4.6",
    "@testing-library/react": "16.0.0",
    "@types/leaflet": "1.9.12",
    "jsdom": "24.1.0",
    "vitest": "1.6.0"
  },
  "engines": {
    "node": ">=22.16.0"
  }
}
